generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  lead
  agent
}

enum TicketSource {
  manual
  api
  webhook
  slack
  crm
}

enum TicketStatus {
  new
  triaged
  in_review
  escalated
  resolved
  archived
}

enum TicketCategory {
  subscription
  bug
  expert_complaint
  refund_request
  account_access
  billing
  product_guidance
  mixed
  unknown
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum AutomationEligibility {
  safe_to_suggest
  human_review_required
  automation_blocked
}

enum AiProvider {
  openai
  anthropic
  mock
}

enum AiRunStatus {
  pending
  succeeded
  failed
  invalid_output
}

enum PromptPurpose {
  ticket_classification
  ticket_summary
  reply_generation
  retrieval_query
  evaluation
}

enum HumanDecision {
  accepted
  edited
  rejected
  escalated
  marked_bad_output
}

enum KnowledgeVisibility {
  internal
  agent_only
  public_safe
}

enum EvalCaseType {
  classification
  reply_generation
  retrieval
  automation_boundary
}

model Organization {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  tickets            Ticket[]
  knowledgeDocuments KnowledgeDocument[]
  promptVersions     PromptVersion[]
  evalCases          EvalCase[]
  auditEvents        AuditEvent[]

  @@map("organizations")
}

model User {
  id             String          @id @default(cuid())
  organizationId String
  email          String
  name           String
  role           UserRole        @default(agent)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTickets Ticket[]        @relation("TicketAssignee")
  aiRuns         AiRun[]
  auditEvents    AuditEvent[]
  feedback       AgentFeedback[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Ticket {
  id              String              @id @default(cuid())
  organizationId  String
  assigneeId      String?
  source          TicketSource        @default(manual)
  status          TicketStatus        @default(new)
  externalId      String?
  customerId      String?
  subject         String?
  text            String
  language        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee        User?               @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  classifications Classification[]
  aiRuns          AiRun[]
  replyVariants   ReplyVariant[]
  auditEvents     AuditEvent[]
  feedback        AgentFeedback[]

  @@unique([organizationId, source, externalId])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([assigneeId])
  @@map("tickets")
}

model Classification {
  id                    String                @id @default(cuid())
  ticketId              String
  category              TicketCategory
  priority              TicketPriority
  automationEligibility AutomationEligibility
  confidence            Decimal               @db.Decimal(5, 4)
  recommendedNextStep   String
  rationale             String
  reviewReasons         String[]
  evidence              Json
  createdAt             DateTime              @default(now())
  ticket                Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  aiRun                 AiRun?

  @@index([ticketId])
  @@index([category, priority])
  @@index([automationEligibility])
  @@map("classifications")
}

model KnowledgeDocument {
  id             String              @id @default(cuid())
  organizationId String
  title          String
  source         String
  sourceUri      String?
  version        String
  language       String              @default("en")
  visibility     KnowledgeVisibility @default(internal)
  tags           String[]
  contentHash    String
  validFrom      DateTime?
  validUntil     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks         KnowledgeChunk[]

  @@unique([organizationId, source, version])
  @@index([organizationId, visibility])
  @@index([organizationId, language])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String                         @id @default(cuid())
  documentId String
  position   Int
  content    String
  contentHash String
  tokenCount Int?
  embedding  Unsupported("vector(1536)")?
  searchText Unsupported("tsvector")?
  metadata   Json                           @default("{}")
  createdAt  DateTime                       @default(now())
  document   KnowledgeDocument              @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
  @@index([documentId])
  @@map("knowledge_chunks")
}

model PromptVersion {
  id             String        @id @default(cuid())
  organizationId String
  purpose        PromptPurpose
  version        String
  provider       AiProvider
  model          String
  schemaName     String
  promptHash     String
  systemPrompt   String
  userTemplate   String
  isActive       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiRuns         AiRun[]
  evalRuns       EvalRun[]

  @@unique([organizationId, purpose, version])
  @@index([organizationId, purpose, isActive])
  @@map("prompt_versions")
}

model AiRun {
  id               String        @id @default(cuid())
  ticketId         String?
  userId           String?
  promptVersionId  String?
  provider         AiProvider
  model            String
  purpose          PromptPurpose
  status           AiRunStatus
  inputMetadata    Json          @default("{}")
  output           Json?
  validationErrors Json?
  latencyMs        Int?
  inputTokens      Int?
  outputTokens     Int?
  costUsd          Decimal?      @db.Decimal(12, 6)
  createdAt        DateTime      @default(now())
  ticket           Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  promptVersion    PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  classification   Classification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)
  classificationId String?       @unique
  replyVariants    ReplyVariant[]
  auditEvents      AuditEvent[]

  @@index([ticketId])
  @@index([purpose, status])
  @@index([createdAt])
  @@map("ai_runs")
}

model ReplyVariant {
  id           String         @id @default(cuid())
  ticketId     String
  aiRunId      String
  tone         String
  content      String
  citations    Json          @default("[]")
  requiresReview Boolean     @default(true)
  createdAt    DateTime      @default(now())
  ticket       Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  aiRun        AiRun         @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  feedback     AgentFeedback[]

  @@index([ticketId])
  @@index([aiRunId])
  @@map("reply_variants")
}

model AgentFeedback {
  id             String         @id @default(cuid())
  ticketId       String
  userId         String
  replyVariantId String?
  decision       HumanDecision
  editedContent  String?
  reason         String?
  createdAt      DateTime       @default(now())
  ticket         Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyVariant   ReplyVariant?  @relation(fields: [replyVariantId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([userId])
  @@index([decision])
  @@map("agent_feedback")
}

model EvalCase {
  id             String        @id @default(cuid())
  organizationId String
  type           EvalCaseType
  name           String
  input          Json
  expectedOutput Json
  tags           String[]
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evalRuns       EvalRun[]

  @@unique([organizationId, type, name])
  @@index([organizationId, type, isActive])
  @@map("eval_cases")
}

model EvalRun {
  id              String         @id @default(cuid())
  evalCaseId      String
  promptVersionId String?
  provider        AiProvider
  model           String
  passed          Boolean
  score           Decimal?       @db.Decimal(5, 4)
  output          Json
  failureReason   String?
  createdAt       DateTime       @default(now())
  evalCase        EvalCase       @relation(fields: [evalCaseId], references: [id], onDelete: Cascade)
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([evalCaseId])
  @@index([promptVersionId])
  @@index([passed])
  @@map("eval_runs")
}

model AuditEvent {
  id             String        @id @default(cuid())
  organizationId String
  ticketId       String?
  userId         String?
  aiRunId        String?
  type           String
  actorType      String
  payload        Json          @default("{}")
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket         Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  aiRun          AiRun?        @relation(fields: [aiRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, type])
  @@index([ticketId])
  @@index([aiRunId])
  @@index([createdAt])
  @@map("audit_events")
}
